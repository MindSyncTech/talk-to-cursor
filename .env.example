# Choose and configure a provider in talktocursor-settings. Environment
# variables override saved settings where noted below.

# ElevenLabs API key (required only when ElevenLabs is selected)
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_api_key_here

# ElevenLabs Voice ID (optional, defaults to a built-in voice)
# You can find voice IDs at: https://elevenlabs.io/app/voice-library
# Popular voices:
#   - Rachel: 21m00Tcm4TlvDq8ikWAM
#   - Adam: pNInz6obpgDQGcFmaJgB
#   - Antoni: ErXwobaYiN019PkySvjV
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# TalkToCursor Cloud device token (optional; normally stored by the settings UI)
# TALKTOCURSOR_CLOUD_TOKEN=ttc_live_your_device_token

# Managed Cloud backend operators configure Google Cloud TTS in cloud/.env.local,
# not in the local MCP client. See cloud/.env.example for the required
# GOOGLE_CLOUD_PROJECT_ID and GOOGLE_CLOUD_SERVICE_ACCOUNT_JSON values.

# Override the per-user settings and signal directory (optional)
# TALKTOCURSOR_DATA_DIR=/absolute/path/to/talktocursor-data

# Python executable used by talktocursor-auto-submit (optional, macOS only)
# TALKTOCURSOR_PYTHON=python3
