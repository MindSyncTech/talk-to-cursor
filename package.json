{
  "name": "talktocursor",
  "version": "1.2.0",
  "description": "Text-to-speech for Cursor, Claude Code, Codex, Antigravity, and compatible MCP coding assistants.",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "talktocursor": "build/index.js",
    "talktocursor-settings": "build/settings-server.js",
    "talktocursor-auto-submit": "build/auto-submit.js"
  },
  "scripts": {
    "build": "tsc && chmod +x build/index.js build/settings-server.js build/auto-submit.js",
    "watch": "tsc --watch",
    "settings": "node build/settings-server.js",
    "auto-submit": "node build/auto-submit.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "text-to-speech",
    "elevenlabs",
    "voicebox",
    "local-tts",
    "cloud-tts",
    "cursor",
    "claude-code",
    "codex",
    "antigravity",
    "tts",
    "voice",
    "hands-free",
    "dictation",
    "model-context-protocol",
    "ai-assistant"
  ],
  "author": "Mike Sheehan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MindSyncTech/talk-to-cursor.git"
  },
  "homepage": "https://talktocursor.com",
  "bugs": {
    "url": "https://github.com/MindSyncTech/talk-to-cursor/issues"
  },
  "files": [
    "build/",
    "public/",
    "scripts/*.py",
    "requirements.txt",
    "INSTALL.md",
    "README.md",
    "SETUP.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.34.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "express": "^5.2.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  }
}
